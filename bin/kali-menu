#!/usr/bin/env python3
"""Kali tools in the Omarchy menu.

Reads Kali's `kali-menu` package out of a distrobox container and writes the
tools it finds as rows in ~/.config/omarchy/extensions/omarchy-menu.jsonc,
which the Omarchy shell hot-reloads on save.

Only tools actually installed in the container are listed -- kali-menu ships
launchers for Kali's entire catalogue, so on a typical install roughly a third
of them point at nothing.

    kali-menu sync        regenerate the rows
    kali-menu doctor      check the install and say what is wrong
    kali-menu link        put the commands on your PATH
    kali-menu unlink      take them off again
    kali-menu uninstall   remove rows and symlinks (run before `omarchy plugin remove`)

Run this on the HOST. It drives distrobox from outside and rewrites the host's
menu file.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from pathlib import Path

CONTAINER = os.environ.get("KALI_CONTAINER", "kali")
HOME = Path.home()
MENU_FILE = HOME / ".config" / "omarchy" / "extensions" / "omarchy-menu.jsonc"
# distrobox mounts the whole host filesystem at /run/host inside every
# container it creates, with no --volume needed. Going through that instead of
# a bind mount the container happens to have means this works against any Kali
# distrobox, not just one built by a particular setup.sh.
HOST_PREFIX = "/run/host"

BEGIN_MARK = "// >>> kali-menu:"
END_MARK = "// <<< kali-menu:"
BEGIN = "  // >>> kali-menu: generated by kali-menu sync -- do not edit inside this block"
END = "  // <<< kali-menu: end generated"

# This script lives at <plugin>/bin/kali-menu, so the plugin directory is two
# levels up. Menu rows reference the wrappers by absolute path from here, which
# is immune to PATH and login-shell differences -- and means removing the plugin
# directory makes every row's `when` guard fail at once.
PLUGIN_DIR = Path(__file__).resolve().parent.parent
BIN_DIR = PLUGIN_DIR / "bin"
LINK_DIR = Path.home() / ".local" / "bin"
LINKED = ("kali-run", "kali-gui", "kali-update", "kali-menu")
def _plugin_id() -> str:
    """The id Omarchy knows this by, which is what `plugin remove` takes.

    Read from the manifest rather than the directory name -- a development
    checkout is named after the repository, and printing that as uninstall
    advice would name a plugin that does not exist.
    """
    try:
        return json.loads((PLUGIN_DIR / "manifest.json").read_text(encoding="utf-8"))["id"]
    except Exception:
        return PLUGIN_DIR.name


PLUGIN_ID = _plugin_id()

ROOT_ID = "kali"
# Explicit codepoints: these are Nerd Font private-use glyphs, and a literal
# paste of one is too easy to lose in an editor or a copy. All four are present
# in the Nerd Fonts Omarchy ships (checked with `fc-list :charset=<cp>`).
ICON_ROOT = "\uf327"          # nf-linux-kali, the dragon
ICON_CATEGORY = "\U000f024b"  # nf-md-folder
ICON_TERMINAL = "\uf489"      # nf-oct-terminal
ICON_GUI = "\U000f01af"       # nf-md-monitor

# The extractor runs *inside* the container, where the kali-menu files live.
EXTRACTOR = r'''
import json, os, re, shlex, shutil, sys, xml.etree.ElementTree as ET

APPS = "/usr/share/kali-menu/applications"
DIRS = "/usr/share/desktop-directories"
MENU = "/etc/xdg/menus/applications-merged/kali-applications.menu"


def desktop_fields(path):
    """Read the [Desktop Entry] group, unlocalised keys only."""
    fields = {}
    in_group = False
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if line.startswith("["):
                in_group = line == "[Desktop Entry]"
                continue
            if not in_group or "=" not in line or line.startswith("#"):
                continue
            key, _, value = line.partition("=")
            # Skip Name[fr] and friends; we only want the default locale.
            if key.endswith("]"):
                continue
            fields.setdefault(key.strip(), value.strip())
    return fields


def directory_name(basename, fallback):
    path = os.path.join(DIRS, basename or "")
    if not basename or not os.path.exists(path):
        return fallback
    name = desktop_fields(path).get("Name", fallback)
    # Kali prefixes submenu names with a bullet to set them apart in XFCE.
    return name.lstrip("• ").strip() or fallback


def base_command(raw_exec):
    """The binary a .desktop Exec ultimately runs, past any wrapper."""
    try:
        argv = shlex.split(raw_exec)
    except ValueError:
        argv = raw_exec.split()
    argv = [a for a in argv if not (len(a) == 2 and a.startswith("%"))]
    if not argv:
        return ""
    if argv[0] == "/usr/share/kali-menu/exec-in-shell":
        inner = " ".join(argv[1:])
        try:
            argv = shlex.split(inner)
        except ValueError:
            argv = inner.split()
    if not argv:
        return ""
    if argv[0] in ("pkexec", "sudo", "doas"):
        rest = [a for a in argv[1:] if not a.startswith("-")]
        if not rest:
            return ""
        argv = rest
    return argv[0]


# Shell builtins and coreutils a helper script uses for presentation rather
# than for the tool it is actually launching.
_PLUMBING = {
    "cd", "ls", "echo", "printf", "sudo", "env", "exec", "sh", "bash", "clear", "read", "sleep",
    "grep", "awk", "sed", "cat", "head", "tail", "tr", "sort", "uniq", "xargs", "which", "id",
}


def helper_script_commands(path):
    """The real tools a kali-menu helper script runs.

    These wrappers exist and are executable even when the tool they launch is
    not installed -- havoc.sh is a live example: two lines invoking `havoc`,
    which no metapackage here provides. Checking the wrapper alone would keep a
    row that dies the moment it is clicked.
    """
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            body = fh.read()
    except OSError:
        return []

    # Strip command substitutions and quoted strings before looking for
    # operators: wireshark.sh opens with $(id -Gn | grep -q ...) and hydra.sh
    # greps for a literal '^\|Supported services:'. Both hide a pipe that is
    # not a command separator, and splitting on it invents commands that were
    # never there.
    body = re.sub(r"\$\([^)]*\)", " ", body)
    body = re.sub(r"'[^']*'", " ", body)
    body = re.sub(r'"[^"]*"', " ", body)

    found = []
    for line in body.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # Split on the operators that separate one command from the next.
        for part in re.split(r"&&|\|\||[;&|]", line):
            tokens = part.split()
            if not tokens:
                continue
            head = tokens[0]
            # Skip `sudo`, env assignments, and the like to reach the real command.
            while tokens and (head in ("sudo", "env") or "=" in head):
                tokens = tokens[1:]
                head = tokens[0] if tokens else ""
            if head and head not in _PLUMBING and head not in found:
                found.append(head)
    return found


def systemd_booted():
    """Whether systemd is running as a service manager, not merely PID 1.

    distrobox starts systemd as the container entrypoint but does not boot it,
    so `systemctl is-system-running` reports "offline" and /run/systemd/system
    is absent. Anything that manages a service then fails with "System has not
    been booted with systemd as init system". A container made with
    `distrobox create --init` does boot it, and there these entries work.
    """
    return os.path.isdir("/run/systemd/system")


def needs_service_manager(command):
    """Does this launcher drive a systemd service?

    Kali wrote these for a real install where systemd runs. They are not broken
    tools and they are installed -- they simply cannot work in a container whose
    systemd was never booted, and the presence check cannot see that.

    Detected via Kali's own kali-service-start/stop helper, which is what most
    of them call, or a direct systemctl invocation (faraday-start).
    """
    if not command or "/" not in command:
        command = shutil.which(command or "") or ""
    if not command or not os.path.isfile(command):
        return False
    try:
        with open(command, "rb") as fh:
            head = fh.read(65536)
    except OSError:
        return False
    if head[:2] != b"#!":
        return False
    return bool(re.search(rb"kali-service-(start|stop)|(^|[;&| \t])systemctl( |$)", head, re.M))


def is_installed(command):
    """kali-menu ships launchers for Kali's whole catalogue, not for what is
    actually installed here, so roughly a third of them point at nothing."""
    if not command:
        return False
    if "/" in command:
        if not os.access(command, os.X_OK):
            return False
        if "/helper-scripts/" in command:
            # Executable, but only useful if what it launches is present.
            # These are named after the tool they wrap (hydra.sh -> hydra),
            # which settles all but the few named after a package instead.
            name = os.path.basename(command)
            if name.endswith(".sh"):
                name = name[:-3]
            if shutil.which(name):
                return True
            wrapped = helper_script_commands(command)
            # A pure listing script (impacket-scripts.sh is `cd` + `ls`) names
            # no tool of its own and is still worth showing.
            return not wrapped or any(shutil.which(c) for c in wrapped)
        return True
    return shutil.which(command) is not None


def entries_by_category():
    index = {}
    if not os.path.isdir(APPS):
        return index
    for name in sorted(os.listdir(APPS)):
        if not name.endswith(".desktop"):
            continue
        fields = desktop_fields(os.path.join(APPS, name))
        if fields.get("NoDisplay", "").lower() == "true":
            continue
        label = fields.get("Name")
        raw_exec = fields.get("Exec", "")
        if not label or not raw_exec:
            continue
        command = base_command(raw_exec)
        resolved = command if "/" in command else (shutil.which(command) or "")
        entry = {
            "needs_systemd": needs_service_manager(resolved),
            "label": label,
            "comment": fields.get("Comment", ""),
            "package": fields.get("X-Kali-Package", ""),
            "terminal": fields.get("Terminal", "").lower() == "true",
            "exec": raw_exec,
            "file": name,
            "command": command,
            "installed": is_installed(command),
        }
        for category in fields.get("Categories", "").split(";"):
            category = category.strip()
            if category:
                index.setdefault(category, []).append(entry)
    return index


def category_of(menu_el):
    """The single <Category> a Kali submenu includes."""
    for include in menu_el.findall("Include"):
        for node in include.iter("Category"):
            if node.text:
                return node.text.strip()
    return ""


def walk(menu_el):
    name = menu_el.findtext("Name", default="").strip()
    directory = menu_el.findtext("Directory", default="").strip()
    return {
        "name": directory_name(directory, name),
        "category": category_of(menu_el),
        "children": [walk(child) for child in menu_el.findall("Menu")],
    }


def main(out_path):
    if not os.path.exists(MENU):
        sys.exit("kali-menu is not installed in this container: %s missing" % MENU)
    root = ET.parse(MENU).getroot()
    tree = [walk(child) for child in root.findall("Menu")]
    payload = {"tree": tree, "entries": entries_by_category(),
               "systemd_booted": systemd_booted()}
    with open(out_path, "w", encoding="utf-8") as fh:
        json.dump(payload, fh)


main(sys.argv[1])
'''


def strip_ordering_prefix(name: str) -> str:
    """Drop Kali's "01 - " menu numbering.

    Kali numbers its top-level categories so XFCE renders them in kill-chain
    order. The Omarchy menu already keeps rows in the order we emit them, so the
    numbers are noise here -- and they would make every id start with a digit.
    """
    head, sep, tail = name.partition(" - ")
    if sep and head.strip().isdigit():
        return tail.strip() or name
    return name


def slugify(value: str) -> str:
    out = []
    for ch in value.lower():
        out.append(ch if ch.isalnum() else "-")
    slug = "".join(out).strip("-")
    while "--" in slug:
        slug = slug.replace("--", "-")
    return slug or "item"


def run_extractor() -> dict:
    if not shutil.which("distrobox"):
        sys.exit("distrobox is not installed")
    workdir = Path(tempfile.mkdtemp(prefix="omarchy-kali-menu-"))
    script_host = workdir / "extract.py"
    out_host = workdir / "tree.json"
    script_host.write_text(EXTRACTOR, encoding="utf-8")

    try:
        # Writing the result to a file rather than stdout keeps distrobox's own
        # first-enter banner from ending up inside the JSON.
        proc = subprocess.run(
            [
                "distrobox", "enter", CONTAINER, "--",
                "python3", f"{HOST_PREFIX}{script_host}", f"{HOST_PREFIX}{out_host}",
            ],
            capture_output=True,
            text=True,
        )
        if not out_host.exists():
            sys.stderr.write(proc.stdout)
            sys.stderr.write(proc.stderr)
            sys.exit(f"extraction failed inside container '{CONTAINER}'")
        return json.loads(out_host.read_text(encoding="utf-8"))
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


# Tools that genuinely need root *and* survive it. Kept deliberately tiny: the
# default is to run as the user, because root breaks GTK apps (see action_for).
#
# This list is an observation from one machine, not a general truth -- another
# install may have pkexec GUIs that really do need root. Extend it without
# editing this file:
#
#   KALI_NEEDS_ROOT=fern-wifi-cracker,someothertool kali-menu sync
_NEEDS_ROOT = {
    t.strip() for t in
    os.environ.get("KALI_NEEDS_ROOT", "fern-wifi-cracker").split(",")
    if t.strip()
}

KALI_RUN = shlex.quote(str(BIN_DIR / "kali-run"))
KALI_GUI = shlex.quote(str(BIN_DIR / "kali-gui"))


def action_for(entry: dict) -> str:
    """Turn a .desktop Exec into a host command that runs it in the container."""
    raw = entry["exec"]
    try:
        argv = shlex.split(raw)
    except ValueError:
        argv = raw.split()
    # Drop .desktop field codes (%f, %U, ...); none of these tools need them.
    argv = [a for a in argv if not (len(a) == 2 and a.startswith("%"))]
    if not argv:
        return ""

    if argv[0] == "/usr/share/kali-menu/exec-in-shell":
        # The interesting case: Kali hands exec-in-shell one string to eval.
        command = " ".join(argv[1:])
        return f"omarchy-launch-tui --app-id=org.omarchy.kali {KALI_RUN} {shlex.quote(command)}"

    if argv[0] == "pkexec" and argv[1:] and argv[1] in _NEEDS_ROOT:
        # Genuinely needs root AND tolerates it. fern-wifi-cracker writes under
        # /usr/share and dies with PermissionError as the user; it is Qt, so it
        # is unaffected by the GTK problem below.
        return f"{KALI_GUI} sudo -E " + " ".join(shlex.quote(a) for a in argv[1:])

    if argv[0] == "pkexec":
        # Kali escalates these with pkexec, which cannot work here: the
        # container has no polkit agent, so it hangs on a prompt nobody can
        # answer. Escalating with sudo instead turns out to be worse than not
        # escalating at all, so these run as the user.
        #
        # Why: Debian's libpixbufloader_svg.so links libglycin, so every SVG
        # icon in a GTK app goes through glycin's bwrap sandbox. As root in
        # this container that loader exits 1 and GTK aborts on the assert in
        # gtkiconhelper.c -- zenmap builds its entire main window, then dies
        # with SIGABRT. As the user it is fine. Measured: `zenmap` alive at
        # 30s, `sudo -E zenmap` aborted at 2s.
        #
        # Root is not needed anyway. The container is created with
        # --cap-add=NET_RAW, so `nmap -sS` works unprivileged -- which is the
        # whole reason these entries wanted root.
        return f"{KALI_GUI} " + " ".join(shlex.quote(a) for a in argv[1:])

    if entry["terminal"]:
        return f"omarchy-launch-tui --app-id=org.omarchy.kali {KALI_RUN} {shlex.quote(' '.join(argv))}"

    return f"{KALI_GUI} " + " ".join(shlex.quote(a) for a in argv)


def jsonc_row(row_id: str, fields: dict) -> str:
    parts = [f'{json.dumps(k)}:{json.dumps(v, ensure_ascii=False)}' for k, v in fields.items()]
    return f'  {json.dumps(row_id)}: {{{",".join(parts)}}}'


def build_rows(payload: dict, include_missing: bool = False) -> tuple[list[str], dict]:
    entries = payload["entries"]
    # A container made with `distrobox create --init` boots systemd, and there
    # the service entries work; only drop them where they cannot.
    booted = payload.get("systemd_booted", True)
    skipped: set[str] = set()
    skipped_svc: set[str] = set()

    def usable(entry: dict) -> bool:
        # Entries from an older extractor have no "installed" key; keep those
        # rather than silently emptying the menu.
        if not (include_missing or entry.get("installed", True)):
            skipped.add(entry.get("command") or entry["label"])
            return False
        if entry.get("needs_systemd") and not booted and not include_missing:
            skipped_svc.add(entry.get("command") or entry["label"])
            return False
        return True
    rows: list[tuple[str, dict]] = []
    seen: set[str] = set()

    def add(row_id: str, fields: dict) -> None:
        if row_id in seen:
            return
        seen.add(row_id)
        rows.append((row_id, fields))

    add(ROOT_ID, {
        "icon": ICON_ROOT,
        "label": "Kali",
        "description": "Kali Linux tools running in the kali distrobox",
        "aliases": ["kali-linux", "pentest", "security", "tools"],
        # One cheap check when the menu opens: hide the tree if the container
        # was removed, rather than offering 500 rows that cannot run.
        # Guards on the plugin directory as well as the container. `omarchy
        # plugin remove` is an rm -rf with no uninstall hook, so without this
        # every row would survive removal pointing at scripts that are gone.
        # Both values are quoted: PLUGIN_DIR can contain spaces, and CONTAINER
        # comes from the environment. This string is run by the shell every
        # time the menu opens.
        "when": f"[ -d {shlex.quote(str(PLUGIN_DIR))} ] && "
                f"podman container exists {shlex.quote(CONTAINER)}",
    })

    add(f"{ROOT_ID}.shell", {
        "icon": ICON_TERMINAL,
        "label": "Kali Shell",
        "description": "Interactive shell inside the kali container",
        "aliases": ["kali-shell", "distrobox"],
        "action": f"omarchy-launch-tui --app-id=org.omarchy.kali {KALI_RUN}",
    })

    def add_tools(parent_id: str, category: str) -> None:
        for entry in entries.get(category, []):
            if not usable(entry):
                continue
            action = action_for(entry)
            if not action:
                continue
            tool_id = f"{parent_id}.{slugify(entry['label'])}"
            if tool_id in seen:
                # Same tool name twice in one category: keep both, distinguished
                # by the .desktop filename.
                tool_id = f"{parent_id}.{slugify(entry['file'][:-len('.desktop')])}"
            fields = {
                "icon": ICON_TERMINAL if entry["terminal"] else ICON_GUI,
                "label": entry["label"],
            }
            description = entry["comment"]
            if description:
                fields["description"] = description
            aliases = [a for a in (entry["package"],) if a and a != entry["label"]]
            if aliases:
                fields["aliases"] = aliases
            fields["action"] = action
            add(tool_id, fields)

    def usable_quiet(entry: dict) -> bool:
        """usable() without recording a skip -- for structural checks that run
        over the same entries repeatedly."""
        if not (include_missing or entry.get("installed", True)):
            return False
        return not (entry.get("needs_systemd") and not booted and not include_missing)

    def has_content(node: dict) -> bool:
        """Does this branch hold anything worth showing, at any depth?"""
        if node["category"] == "kali-usual-applications":
            return False
        if any(usable_quiet(e) for e in entries.get(node["category"], [])):
            return True
        return any(has_content(child) for child in node["children"])

    def add_menu(parent_id: str, node: dict) -> None:
        category = node["category"]
        # Kali's XML carries a "Usual Applications" branch for the desktop's own
        # apps; on Omarchy those belong to the host, not this tree.
        if category == "kali-usual-applications":
            return
        own = [e for e in entries.get(category, []) if usable_quiet(e)]
        if not own and not any(has_content(c) for c in node["children"]):
            return
        name = strip_ordering_prefix(node["name"])
        menu_id = f"{parent_id}.{slugify(name)}"
        add(menu_id, {
            "icon": ICON_CATEGORY,
            "label": name,
            "description": f"Kali: {name}",
        })
        add_tools(menu_id, category)
        for child in node["children"]:
            add_menu(menu_id, child)

    for node in payload["tree"]:
        add_menu(ROOT_ID, node)

    return ([jsonc_row(row_id, fields) for row_id, fields in rows],
            {"missing": len(skipped), "needs_systemd": len(skipped_svc), "booted": booted})


def ensure_trailing_comma(head_lines: list[str]) -> list[str]:
    """Give the last real row before our block a comma, skipping comments."""
    for i in range(len(head_lines) - 1, -1, -1):
        stripped = head_lines[i].strip()
        if not stripped or stripped.startswith("//"):
            continue
        if stripped.endswith(("{", ",")):
            return head_lines
        head_lines[i] = head_lines[i].rstrip() + ","
        return head_lines
    return head_lines


def splice(block_lines: list[str] | None) -> str:
    text = MENU_FILE.read_text(encoding="utf-8")
    lines = text.splitlines()

    # Match on a stable prefix, not the whole line: the human-readable tail of
    # the sentinel has changed once already, and an exact match would silently
    # treat an existing block as absent and append a second one beside it.
    begin_at = next((i for i, l in enumerate(lines) if l.strip().startswith(BEGIN_MARK)), None)
    end_at = next((i for i, l in enumerate(lines) if l.strip().startswith(END_MARK)), None)

    if begin_at is not None and end_at is not None and end_at > begin_at:
        head, tail = lines[:begin_at], lines[end_at + 1:]
    else:
        # First run: land just before the object's closing brace.
        close_at = max(i for i, l in enumerate(lines) if l.strip() == "}")
        head, tail = lines[:close_at], lines[close_at:]

    if block_lines is None:
        # Removing: the comma we added is now a trailing comma, so strip it.
        while head and not head[-1].strip():
            head.pop()
        if head and head[-1].rstrip().endswith(","):
            head[-1] = head[-1].rstrip()[:-1]
        return "\n".join(head + tail) + "\n"

    head = ensure_trailing_comma(head)
    return "\n".join(head + [BEGIN] + block_lines + [END] + tail) + "\n"


KEEP_BACKUPS = 5


def write_atomic(path: Path, text: str) -> None:
    """Replace `path` in one step, so a watcher never sees it half-written.

    The Omarchy shell hot-reloads this file the moment it changes. A plain
    write truncates first and then streams ~150KB back, which leaves a window
    where the watcher can read a partial file, fail to parse it, and drop every
    user row until the shell is restarted. Writing a sibling temp file and
    renaming makes the swap atomic: readers see either the old file or the new
    one, never a fragment.
    """
    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    try:
        tmp.write_text(text, encoding="utf-8")
        # Same directory, so this is a true atomic rename on the same filesystem.
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def prune_backups() -> None:
    """Keep only the newest few .bak files.

    Run from kali-update after every container upgrade, these accumulate one per
    run and each is ~150KB. Backups made by anything other than this script --
    the .bak.auto-lock one, say -- are matched by a different name and left
    alone.
    """
    backups = sorted(
        MENU_FILE.parent.glob(f"{MENU_FILE.stem}.jsonc.bak.kali-menu-*"),
        key=lambda p: p.name,
        reverse=True,
    )
    for stale in backups[KEEP_BACKUPS:]:
        stale.unlink(missing_ok=True)


def cmd_sync(args) -> None:
    payload = run_extractor()
    block, skipped = build_rows(payload, include_missing=args.include_missing)
    n_missing, n_svc = skipped["missing"], skipped["needs_systemd"]
    block = [l + "," for l in block[:-1]] + block[-1:]

    if args.dry_run:
        print(BEGIN)
        print("\n".join(block))
        print(END)
        print(f"\n# {len(block)} rows, {n_missing} not installed, "
              f"{n_svc} need a booted systemd", file=sys.stderr)
        return

    backup = MENU_FILE.with_suffix(f".jsonc.bak.kali-menu-{time.strftime('%Y%m%d-%H%M%S')}")
    shutil.copy2(MENU_FILE, backup)
    prune_backups()
    write_atomic(MENU_FILE, splice(block))
    print(f"wrote {len(block)} rows to {MENU_FILE}")
    if n_missing:
        print(f"skipped {n_missing} tools that are not installed (--include-missing keeps them)")
    if n_svc:
        print(f"skipped {n_svc} service entries: systemd is not booted in this container "
              f"(distrobox create --init boots it)")
    print(f"previous version saved as {backup}")


def cmd_remove(args) -> None:
    write_atomic(MENU_FILE, splice(None))
    print(f"removed the kali-menu block from {MENU_FILE}")


def cmd_link(args) -> None:
    """Put the commands on PATH.

    Symlinks live in ~/.local/bin, never inside the plugin directory: plugin
    validation rejects a folder containing any symlink, and anything written
    under the plugin directory retriggers the shell's inotify reload.
    """
    LINK_DIR.mkdir(parents=True, exist_ok=True)
    for name in LINKED:
        target, link = BIN_DIR / name, LINK_DIR / name
        if link.is_symlink() or link.exists():
            if link.is_symlink() and link.resolve() == target:
                continue
            print(f"  skip {link} (exists, not ours)")
            continue
        link.symlink_to(target)
        print(f"  linked {link} -> {target}")
    print(f"done. {LINK_DIR} is on PATH via /etc/profile.")


def cmd_unlink(args) -> None:
    for name in LINKED:
        link = LINK_DIR / name
        if link.is_symlink() and link.resolve().parent == BIN_DIR:
            link.unlink()
            print(f"  removed {link}")


def cmd_uninstall(args) -> None:
    """Everything `omarchy plugin remove` cannot do for us.

    That command is an rm -rf with no uninstall hook, so the menu rows and any
    PATH symlinks would outlive the plugin. Run this first.
    """
    if MENU_FILE.exists():
        cmd_remove(args)
    cmd_unlink(args)
    print("\nnow safe to run: omarchy plugin remove " + PLUGIN_ID)


# Collected so doctor can render either for a human or as JSON. An agent
# troubleshooting this should not have to scrape console text.
_RESULTS: list[dict] = []


def _check(label, ok, detail="", hint=""):
    _RESULTS.append({"check": label, "ok": bool(ok), "detail": detail, "hint": hint})
    return ok


def cmd_skill(args) -> None:
    """Install the troubleshooting skill for Claude Code.

    Copied rather than symlinked: the skills directory is scanned, and a plugin
    directory must contain no symlinks anyway.
    """
    src = PLUGIN_DIR / "skills" / "omarchy-kali"
    dest = Path.home() / ".claude" / "skills" / "omarchy-kali"
    if not src.is_dir():
        sys.exit(f"missing {src}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest)
    print(f"installed {dest}")
    print("agents will pick it up when troubleshooting the Kali menu.")


def cmd_doctor(args) -> None:
    """Say what is wrong, in the order it would break."""
    _RESULTS.clear()
    failures = 0

    for tool in ("distrobox", "podman"):
        # No plugin dependency mechanism exists, so check at runtime.
        failures += not _check(f"{tool} installed", shutil.which(tool) is not None,
                               hint=f"omarchy pkg add {tool}")

    for name in LINKED:
        f = BIN_DIR / name
        failures += not _check(
            f"bin/{name} executable", f.exists() and os.access(f, os.X_OK),
            "" if f.exists() else "missing",
        )

    exists = subprocess.run(["podman", "container", "exists", CONTAINER]).returncode == 0
    failures += not _check(f"container '{CONTAINER}' exists", exists,
                           hint=f"{PLUGIN_DIR}/container/setup.sh, or set KALI_CONTAINER")

    if exists:
        probe = subprocess.run(
            ["distrobox", "enter", CONTAINER, "--", "bash", "-lc",
             "test -d /run/host && echo HOST_OK; "
             "test -f /etc/xdg/menus/applications-merged/kali-applications.menu && echo MENU_OK; "
             "ls /usr/share/kali-menu/applications/*.desktop 2>/dev/null | wc -l"],
            capture_output=True, text=True)
        out = probe.stdout
        failures += not _check("/run/host reachable from container", "HOST_OK" in out)
        failures += not _check(
            "kali-menu installed in container", "MENU_OK" in out,
            "" if "MENU_OK" in out else "the package that provides every menu row is absent",
            hint=f"distrobox enter {shlex.quote(CONTAINER)} -- sudo apt install kali-menu")
        launchers = next((l for l in out.splitlines() if l.strip().isdigit()), "0")
        _check(f"{launchers} launchers available", True)

    if MENU_FILE.exists():
        text = MENU_FILE.read_text(encoding="utf-8")
        body = "\n".join(l for l in text.splitlines() if not l.strip().startswith("//"))
        try:
            rows = json.loads(body)
            failures += not _check(f"menu file parses ({len(rows)} rows)", True)
            ours = [k for k in rows if k == ROOT_ID or k.startswith(ROOT_ID + ".")]
            tools = [k for k, v in rows.items()
                     if k.startswith(ROOT_ID + ".") and isinstance(v, dict) and v.get("action")]
            failures += not _check(f"{len(ours)} kali rows present", bool(ours))
            _check(f"{len(rows) - len(ours)} hand-written rows preserved", True)
            _check("tool count reasonable", not (0 < len(tools) < 40),
                   f"only {len(tools)} tools" if 0 < len(tools) < 40 else "",
                   hint="a bigger metapackage gives more: kali-linux-default ~298, "
                        "kali-linux-large ~448" if 0 < len(tools) < 40 else "")
        except json.JSONDecodeError as exc:
            failures += not _check("menu file parses", False, str(exc))
        has_begin = any(l.strip().startswith(BEGIN_MARK) for l in text.splitlines())
        has_end = any(l.strip().startswith(END_MARK) for l in text.splitlines())
        failures += not _check("generated block intact", has_begin == has_end,
                               "" if has_begin == has_end else "one sentinel is missing")
    else:
        failures += not _check("menu file exists", False, str(MENU_FILE))

    context = {
        "plugin_dir": str(PLUGIN_DIR),
        "plugin_id": PLUGIN_ID,
        "container": CONTAINER,
        "menu_file": str(MENU_FILE),
    }
    if args.json:
        print(json.dumps({**context, "ok": not failures, "checks": _RESULTS}, indent=2))
    else:
        for k, v in context.items():
            print(f"{k + ':':12}{v}")
        print()
        for r in _RESULTS:
            print(f"  [{'ok  ' if r['ok'] else 'FAIL'}] {r['check']}"
                  + (f" -- {r['detail']}" if r["detail"] else ""))
            if not r["ok"] and r["hint"]:
                print(f"         try: {r['hint']}")
        print("\n" + ("all checks passed" if not failures else f"{failures} problem(s) above"))
    sys.exit(1 if failures else 0)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command")

    p_sync = sub.add_parser("sync", help="regenerate the menu rows")
    p_sync.add_argument("--dry-run", action="store_true", help="print the block, change nothing")
    p_sync.add_argument("--include-missing", action="store_true",
                        help="also emit rows for tools not installed in the container")
    p_sync.set_defaults(func=cmd_sync)

    p_doc = sub.add_parser("doctor", help="check the install and report what is wrong")
    p_doc.add_argument("--json", action="store_true",
                       help="machine-readable output, for scripts and agents")
    p_doc.set_defaults(func=cmd_doctor, dry_run=False, include_missing=False)

    for name, fn, helptext in (
        ("remove", cmd_remove, "remove the generated rows"),
        ("link", cmd_link, "symlink the commands into ~/.local/bin"),
        ("unlink", cmd_unlink, "remove those symlinks"),
        ("uninstall", cmd_uninstall, "remove rows and symlinks"),
        ("skill", cmd_skill, "install the troubleshooting skill into ~/.claude/skills"),
    ):
        sp = sub.add_parser(name, help=helptext)
        sp.set_defaults(func=fn, dry_run=False, include_missing=False, json=False)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(2)

    if args.command != "doctor" and not MENU_FILE.exists():
        sys.exit(
            f"missing {MENU_FILE}\n"
            "Omarchy ships this file; restore it with:\n"
            "  omarchy refresh config omarchy/extensions/omarchy-menu.jsonc")
    args.func(args)


if __name__ == "__main__":
    main()
