#!/usr/bin/env bash
# Launch a Kali GUI app from inside the `kali` distrobox with no terminal
# window, detached from whatever started it (the Omarchy menu, a keybinding).
#
# distrobox already forwards the Wayland/X11 socket, so the app appears as a
# normal window. uwsm-app puts it in its own systemd scope, which is what the
# rest of Omarchy does for graphical launches.
#
# A detached launch has nowhere to print, so a failure is completely silent --
# the menu row just does nothing. That is a miserable thing to debug, so an
# early exit raises a desktop notification carrying the actual error.
#
#   kali-gui burpsuite

set -uo pipefail

# Which container to use: the environment wins (a one-off override), then the
# choice persisted by `kali-menu use`, then the default.
kali_container() {
  if [ -n "${KALI_CONTAINER:-}" ]; then
    printf '%s' "$KALI_CONTAINER"
    return
  fi
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-kali/container"
  if [ -s "$f" ]; then
    local name
    name=$(head -n1 "$f" | tr -d '[:space:]')
    [ -n "$name" ] && { printf '%s' "$name"; return; }
  fi
  printf 'kali'
}

CONTAINER="$(kali_container)"
# A GUI that dies faster than this failed to start; one that outlives it was a
# real session the user ended, and is none of our business.
STARTUP_GRACE=10

# Off by default -- toggled from Kali > Settings > Dark mode (`kali-menu theme`),
# which writes this same file. Only GTK apps honour it directly; Qt apps pick it
# up too because QT_QPA_PLATFORMTHEME=gtk3 is already inherited from the host
# session. Swing apps (Burp, Ghidra, ZAP) ignore it -- they keep their own theme
# setting, toggled once inside the app.
kali_gui_theme() {
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-kali/gui-theme"
  [ -s "$f" ] && head -n1 "$f" | tr -d '[:space:]' || printf 'light'
}

GTK_THEME_ENV=
[ "$(kali_gui_theme)" = dark ] && GTK_THEME_ENV="GTK_THEME=Adwaita:dark"

if [[ $# -eq 0 ]]; then
  echo "usage: kali-gui <command> [args...]" >&2
  exit 1
fi

app=$1

launch() {
  local log status
  log=$(mktemp "/tmp/kali-gui-${app##*/}.XXXXXX.log")

  local start=$SECONDS
  uwsm-app -- distrobox enter "$CONTAINER" -- env $GTK_THEME_ENV "$@" >"$log" 2>&1
  status=$?

  if (( status != 0 && SECONDS - start < STARTUP_GRACE )); then
    local detail
    # The last non-empty line is almost always the actual complaint.
    detail=$(grep -v '^[[:space:]]*$' "$log" | tail -1)
    [[ -z $detail ]] && detail="exited $status with no output"
    notify-send -u critical -a "Kali" "$app failed to start" "$detail"
  fi

  rm -f "$log"
}

# setsid so the app outlives the menu process that invoked us.
setsid bash -c "$(declare -f launch); app=$(printf %q "$app"); CONTAINER=$(printf %q "$CONTAINER"); STARTUP_GRACE=$STARTUP_GRACE; GTK_THEME_ENV=$(printf %q "$GTK_THEME_ENV"); launch $(printf '%q ' "$@")" >/dev/null 2>&1 &

disown
